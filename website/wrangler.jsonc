{
  "name": "traffic-ledger-site",
  "compatibility_date": "2026-10-20",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "clash-verge-monitor.timmyagentic.si",
      "custom_domain": true
    },
    {
      "pattern": "traffic-ledger.timmyagentic.si",
      "custom_domain": true
    }
  ],
  "main": "worker.mjs"
}
